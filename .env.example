# Public URL that proxies must reach (tunnel / VPS / port-forward → JUDGE_PORT).
# Uncomment to enable anonymity mode for check/run (overrides need for --check).
# Path should match what the local judge serves (default /judge).
# JUDGE_PUBLIC_URL=https://judge.example.com/judge

# Local bind — use 0.0.0.0 (all interfaces). Do NOT put your public IP here
# (EADDRNOTAVAIL): the public address belongs in JUDGE_PUBLIC_URL only.
JUDGE_HOST=0.0.0.0
JUDGE_PORT=8787

# Set to 1 when a reverse-proxy/tunnel sits in front (ngrok, Cloudflare, nginx)
JUDGE_TRUST_PROXY=0

# Optional: your real public IP. If empty, resolved via a direct GET to JUDGE_PUBLIC_URL
# JUDGE_REAL_IP=1.2.3.4
